<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ads_sdk_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ads_sdk_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ads_sdk_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ads_sdk_headline"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ads_sdk_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ads_sdk_body"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/ads_sdk_cta"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/ads_sdk_cta"
            android:textAllCaps="false"
            android:textColor="@color/ads_sdk_cta_text"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.gms.ads.nativead.AdChoicesView
        android:id="@+id/ads_sdk_ad_choices"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top" />
</com.google.android.gms.ads.nativead.NativeAdView>
