<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ads SDK — XML demo"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ready"
            android:textColor="#475569" />

        <Button
            android:id="@+id/btnInter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show interstitial" />

        <Button
            android:id="@+id/btnInterForce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show interstitial (ignore interval)" />

        <Button
            android:id="@+id/btnRewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load + show rewarded" />

        <Button
            android:id="@+id/btnToggleResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable resume ads" />

        <Button
            android:id="@+id/btnAdInspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Ad Inspector"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Home bottom (Pirago medium ↔ small)"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/homeBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Native medium (SDK template)"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/nativeMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Native DIY custom (adHeadline)"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/nativeCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Native Pirago medium (native_ad_* + CTA ViewGroup)"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/nativePirago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Native Pirago fullscreen fixture (adAppIcon)"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/nativePiragoFullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
